rules_version = '2';

// Craft rules based on project localbazar-cff07 requirements:
// Users can read listing images publicly.
// Users can only upload and write images under their own userId path.
// Limits file size to 10MB and requires image content-type.
service firebase.storage {
  match /b/{bucket}/o {
    match /listings/{userId}/{listingId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // For local development or non-blocking clients:
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
